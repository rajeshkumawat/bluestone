---
/**
 * Team Grid — 4-column grid of partner cards. Each card opens a
 * full-screen blurred modal with the member's full bio.
 *
 * Modal a11y:
 *   – role="dialog" aria-modal="true"
 *   – focus trapped while open (close button initially focused)
 *   – Escape closes
 *   – body scroll locked
 *   – returns focus to the trigger card on close
 */
import type { TeamGridBlock } from "@content";
import { getTeamMembers } from "@content";

type Props = TeamGridBlock;
const { memberSlugs } = Astro.props;

// Resolve slugs → full member records, preserving order
const all = await getTeamMembers();
const members = memberSlugs
  .map((slug) => all.find((m) => m.slug === slug))
  .filter(Boolean) as typeof all;

// JSON blob emitted into the page so client-side modal can look up
// bios by slug without an extra fetch.
const membersBySlug = Object.fromEntries(members.map((m) => [m.slug, m]));
---

<section data-block="team-grid" class="section bg-[var(--color-bg)]">
  <div class="container-max">
    <!--
      2 cols on phones (instead of 1) — better space use for headshots
      and matches the visual density of the desktop grid.
    -->
    <ul
      data-team-grid
      class="grid gap-x-6 gap-y-10 sm:gap-x-8 sm:gap-y-12 grid-cols-2 md:grid-cols-3 lg:grid-cols-4"
    >
      {
        members.map((m) => (
          <li data-team-card class="flex flex-col gap-6">
            <button
              type="button"
              data-bio-trigger
              data-slug={m.slug}
              class="group flex flex-col gap-4 sm:gap-6 text-left w-full h-full cursor-pointer focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-primary)]"
              aria-label={`Read biography for ${m.fullName ?? m.name}`}
            >
              {/* Photo (or placeholder) */}
              <div class="relative aspect-[4/5] w-full overflow-hidden rounded-[10px] bg-[var(--color-tertiary)]">
                {m.photo ? (
                  <img
                    src={m.photo}
                    alt={m.name}
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center text-[var(--color-primary-30)]">
                    <svg width="56" height="56" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path
                        d="M3 18l5-5 4 4 6-7 3 4v6H3v-2zM3 5h18v8M8 9a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"
                        stroke="currentColor"
                        stroke-width="1.2"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </div>
                )}
              </div>

              {/* Info */}
              <div class="flex flex-col gap-3">
                <h3 class="font-display text-[clamp(24px,2.4vw,36px)] leading-[1.05] text-[var(--color-primary)]">
                  {m.name}
                </h3>
                <p class="body-l tracking-[1px] uppercase text-[var(--color-text)]">
                  {m.title}
                </p>
              </div>

              {/* Read more affordance */}
              <span class="mt-auto self-start body-l tracking-[1px] text-[var(--color-primary)] inline-flex items-center gap-1">
                <span class="relative">
                  View Biography
                  <span class="absolute left-0 -bottom-0.5 h-px w-full origin-left scale-x-0 bg-[var(--color-primary)] transition-transform duration-300 group-hover:scale-x-100" />
                </span>
                <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">
                  →
                </span>
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- ── Modal ─────────────────────────────────────────── -->
<!--
  One modal instance, content swapped per click. Sits at the page
  level (outside the section) so it can use position:fixed without
  inheriting any transform/clip context.
-->
<div
  id="team-bio-modal"
  data-bio-modal
  class="fixed inset-0 z-[55] hidden items-center justify-center p-8"
  aria-hidden="true"
  style="display:none;"
>
  <!-- Backdrop -->
  <div
    data-bio-backdrop
    class="fixed inset-0 bg-[rgba(32,56,100,0.85)]"
    style="backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);"
  ></div>

  <!-- Card -->
  <article
    data-bio-card
    role="dialog"
    aria-modal="true"
    aria-labelledby="bio-modal-name"
    class="relative bg-white rounded-[10px] shadow-2xl w-full overflow-y-auto"
    style="max-width: min(720px, calc(100vw - 32px)); max-height: calc(100vh - 64px); -webkit-overflow-scrolling: touch; overscroll-behavior: contain;"
  >
    <button
      type="button"
      data-bio-close
      aria-label="Close biography"
      class="absolute top-4 right-4 inline-flex h-10 w-10 items-center justify-center rounded-full bg-[var(--color-primary)] text-white hover:bg-[#1a2e54] transition-colors z-10"
    >
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </button>

    <div class="p-8 sm:p-12">
      <h2
        id="bio-modal-name"
        data-bio-name
        class="font-display text-[clamp(34px,4.5vw,60px)] leading-[1.05] text-[var(--color-text)]"
      ></h2>
      <p
        data-bio-title
        class="mt-3 font-display text-[clamp(20px,2vw,26px)] leading-tight text-[var(--color-primary)]"
      ></p>
      <div class="mt-4 flex items-center gap-2">
        <a
          data-bio-linkedin
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-8 w-8 items-center justify-center rounded-sm bg-[var(--color-primary)] text-white hover:bg-[#1a2e54] transition-colors"
          aria-label="LinkedIn profile"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M19 0H5C2.24 0 0 2.24 0 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5V5c0-2.76-2.24-5-5-5zM8 19H5V8h3v11zM6.5 6.73c-.97 0-1.75-.79-1.75-1.75s.78-1.74 1.75-1.74 1.75.78 1.75 1.74-.78 1.75-1.75 1.75zM20 19h-3v-5.6c0-3.37-4-3.12-4 0V19h-3V8h3v1.77c1.4-2.59 7-2.78 7 2.47V19z"
            />
          </svg>
        </a>
        <a
          data-bio-email
          href="#"
          class="inline-flex h-8 w-8 items-center justify-center rounded-sm bg-[var(--color-primary)] text-white hover:bg-[#1a2e54] transition-colors"
          aria-label="Email"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="M3 7l9 6 9-6" />
          </svg>
        </a>
      </div>
      <div data-bio-body class="mt-6 flex flex-col gap-4 body-l text-[var(--color-text)]"></div>
    </div>
  </article>
</div>

<!-- Bio data for the modal lookup. -->
<script id="team-members-data" type="application/json" set:html={JSON.stringify(membersBySlug)} />

<style>
  /*
    Pre-hide team cards in CSS so they don't flash visible before
    setupBatchReveal's scroll-triggered animation kicks in. GSAP then
    animates each one in as it enters the viewport.
  */
  [data-team-card] {
    opacity: 0;
    transform: translateY(28px);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-team-card] {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import { gsap, setupBatchReveal } from "@lib/animations";
  import type { TeamMember } from "@content";

  // Fetched at runtime (set on window for the modal to look up)
  const grid = document.querySelector<HTMLElement>("[data-team-grid]");

  // Each card reveals as IT enters the viewport (batched if several
  // land at once). Feels like the grid is filling in as you scroll.
  if (grid) {
    setupBatchReveal("[data-team-card]", {
      y: 28,
      stagger: 0.07,
      duration: 0.9,
      start: "top 90%",
    });
  }

  // ── Modal logic ──
  const modal = document.querySelector<HTMLElement>("[data-bio-modal]");
  const card = document.querySelector<HTMLElement>("[data-bio-card]");
  const backdrop = document.querySelector<HTMLElement>("[data-bio-backdrop]");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-bio-close]");
  const elName = document.querySelector<HTMLElement>("[data-bio-name]");
  const elTitle = document.querySelector<HTMLElement>("[data-bio-title]");
  const elBody = document.querySelector<HTMLElement>("[data-bio-body]");
  const elLinkedIn = document.querySelector<HTMLAnchorElement>("[data-bio-linkedin]");
  const elEmail = document.querySelector<HTMLAnchorElement>("[data-bio-email]");

  // Build a slug → member map from a JSON blob the page emits
  const dataScript = document.getElementById("team-members-data");
  const members: Record<string, TeamMember> = dataScript
    ? JSON.parse(dataScript.textContent || "{}")
    : {};

  let lastFocused: HTMLElement | null = null;

  // Mobile hamburger button — hidden while the bio modal is open so it
  // doesn't sit on top of the modal's own close button (hamburger is
  // z-[60], modal is z-[55]).
  const mobileToggle = document.querySelector<HTMLElement>("[data-mobile-toggle]");

  const open = (slug: string, trigger: HTMLElement) => {
    const m = members[slug];
    if (!m || !modal || !elName || !elTitle || !elBody) return;

    lastFocused = trigger;
    if (mobileToggle) mobileToggle.style.display = "none";

    elName.textContent = m.fullName ?? m.name;
    elTitle.textContent = m.modalTitle ?? m.title;
    elBody.innerHTML = m.bio.map((p) => `<p>${escapeHtml(p)}</p>`).join("");

    // Both icons render on every bio. When a team member has personal
    // contact info we use it; otherwise we fall back to the company's
    // LinkedIn page and the general info@ inbox so the icons always
    // have somewhere to go.
    const COMPANY_LINKEDIN = "https://www.linkedin.com/company/bluestone-investment-partners/";
    const COMPANY_EMAIL = "info@bluestoneinv.com";

    if (elLinkedIn) {
      elLinkedIn.href = m.linkedin || COMPANY_LINKEDIN;
      elLinkedIn.style.display = "";
    }

    if (elEmail) {
      elEmail.href = `mailto:${m.email || COMPANY_EMAIL}`;
      elEmail.style.display = "";
    }

    modal.style.display = "flex";
    modal.setAttribute("aria-hidden", "false");
    if (card) card.scrollTop = 0;

    // Lock background scroll (position:fixed is the only reliable cross-browser
    // technique; overflow:hidden on html doesn't stop wheel scroll in Chrome).
    const scrollY = window.scrollY;
    document.documentElement.dataset.bioScrollY = String(scrollY);
    document.body.style.position = "fixed";
    document.body.style.top = `-${scrollY}px`;
    document.body.style.width = "100%";

    // Animate in
    gsap.fromTo(backdrop, { opacity: 0 }, { opacity: 1, duration: 0.3, ease: "power2.out" });
    gsap.fromTo(
      card,
      { opacity: 0, y: 24, scale: 0.98 },
      { opacity: 1, y: 0, scale: 1, duration: 0.5, ease: "expo.out" },
    );

    requestAnimationFrame(() => closeBtn?.focus());
  };

  const close = () => {
    if (!modal) return;
    gsap.to(card, {
      opacity: 0,
      y: 16,
      scale: 0.98,
      duration: 0.3,
      ease: "power2.in",
    });
    gsap.to(backdrop, {
      opacity: 0,
      duration: 0.3,
      ease: "power2.in",
      onComplete: () => {
        modal.style.display = "none";
        modal.setAttribute("aria-hidden", "true");
        document.body.style.position = "";
        document.body.style.top = "";
        document.body.style.width = "";
        const savedY = parseInt(document.documentElement.dataset.bioScrollY ?? "0", 10);
        window.scrollTo(0, savedY);
        if (mobileToggle) mobileToggle.style.display = "";
        lastFocused?.focus();
      },
    });
  };

  // Wire triggers
  document.querySelectorAll<HTMLButtonElement>("[data-bio-trigger]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const slug = btn.dataset.slug;
      if (slug) open(slug, btn);
    });
  });

  closeBtn?.addEventListener("click", close);
  backdrop?.addEventListener("click", close);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal?.getAttribute("aria-hidden") === "false") {
      close();
    }
  });

  // The body is position:fixed while the modal is open (stops background scroll),
  // but that causes the browser to discard wheel events instead of routing them
  // to the card. Fix: intercept wheel on the card and manually apply the scroll.
  card?.addEventListener("wheel", (e) => {
    e.preventDefault();
    // deltaMode: 0=px, 1=lines (~40px each), 2=pages
    const delta = e.deltaMode === 1 ? e.deltaY * 40 : e.deltaMode === 2 ? e.deltaY * (card.clientHeight || 600) : e.deltaY;
    card.scrollTop += delta;
  }, { passive: false });

  // Tiny HTML escaper
  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }
</script>
