---
/**
 * Investments List — filter pills + 3-col grid of portfolio cards.
 *
 * Per Figma frame 8243:3534:
 *   – Filter pills: All | Active | Realized (active = navy filled)
 *   – 3-col grid (2 on tablet, 1 on phone), min-h 212px per card
 *   – Each card: bordered box with logo centered, "Learn More →" reveals on hover
 *   – Clicking a card opens a full-screen modal (not a new page)
 *
 * Modal layout (per client request, May 2026):
 *   Logo → Company name → Investment Date + Status → Description →
 *   Platform Acquisitions → Related News → Website
 *
 * Filtering is client-side (instant). Cards animate as each enters view.
 */
import { getInvestments, getParentInvestments, getArticles } from "@content";

const all = await getInvestments();           // grid cards (incl. child companies)
const parents = await getParentInvestments(); // modal data source (parents only)
const articles = await getArticles();

// Lookups embedded in the page for client-side modal rendering
const articlesBySlug = Object.fromEntries(
  articles.map((a) => [a.slug, { title: a.title, slug: a.slug }])
);
const investmentsBySlug = Object.fromEntries(parents.map((inv) => [inv.slug, inv]));

const modalData = { investments: investmentsBySlug, articles: articlesBySlug };
---

<section data-block="investments-list" class="section bg-[var(--color-bg)]">
  <div class="container-max flex flex-col items-center gap-8">
    {/* Filter pills */}
    <div data-investments-filter role="tablist" aria-label="Filter investments" class="flex flex-nowrap gap-2 sm:gap-4 self-center lg:self-start">
      {
        ([
          { id: "all", label: "All" },
          { id: "active", label: "Active" },
          { id: "realized", label: "Realized" },
        ] as const).map((f, i) => (
          <button
            type="button"
            role="tab"
            data-filter={f.id}
            aria-selected={i === 0 ? "true" : "false"}
            class:list={[
              "h-10 px-6 sm:px-10 rounded-full body-s tracking-[0.2px] transition-colors duration-200 cursor-pointer border whitespace-nowrap",
              i === 0
                ? "bg-[var(--color-primary)] border-[var(--color-primary)] text-[var(--color-bg)]"
                : "bg-[var(--color-bg)] border-[var(--color-primary)] text-[var(--color-primary)] hover:bg-[var(--color-tertiary)]",
            ]}
          >
            {f.label}
          </button>
        ))
      }
    </div>

    {/* Grid */}
    <ul data-investments-grid class="grid w-full gap-4 grid-cols-2 lg:grid-cols-3">
      {
        all.map((inv) => (
          <li data-investment-card data-status={inv.status} class="contents">
            <button
              type="button"
              data-inv-trigger
              data-slug={inv.parentSlug ?? inv.slug}
              aria-label={`View details for ${inv.name}`}
              class="group relative flex h-full aspect-[7/6] sm:aspect-auto sm:min-h-[260px] flex-col items-center justify-center gap-1 sm:gap-0 transition-[gap,transform,box-shadow,border-color] duration-[500ms] ease-[cubic-bezier(0.22,1,0.36,1)] overflow-hidden rounded-[10px] border border-[var(--color-primary-20)] bg-white p-2 sm:p-8 hover:-translate-y-1 hover:border-[var(--color-primary)] hover:shadow-[0_20px_30px_-15px_rgba(32,56,100,0.18)] w-full cursor-pointer text-left focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-primary)]"
            >
              <div class="flex flex-1 sm:flex-none sm:h-[160px] w-full items-center justify-center min-h-0">
                <img
                  src={inv.logo}
                  alt={inv.name}
                  class="max-h-[68px] max-w-[70%] sm:max-h-[108px] sm:max-w-[75%] w-auto h-auto object-contain sm:grayscale sm:opacity-70 transition-[filter,opacity,transform] duration-[500ms] ease-[cubic-bezier(0.22,1,0.36,1)] sm:group-hover:grayscale-0 sm:group-hover:opacity-100 group-hover:scale-[1.04]"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              {/*
                Learn More — collapsed to 0 height on desktop so the logo stays
                centered. On hover the wrapper grows, pushing the logo up and
                revealing the label. Mobile keeps it always visible.
              */}
              <div class="overflow-hidden sm:max-h-0 sm:group-hover:max-h-[40px] transition-[max-height] duration-[500ms] ease-[cubic-bezier(0.22,1,0.36,1)]">
                <span class="learn-more-label group/learn body-s sm:body-l tracking-[0.5px] sm:tracking-[1px] text-[var(--color-primary)] sm:opacity-0 sm:translate-y-2 transition-[opacity,transform] duration-[500ms] ease-[cubic-bezier(0.22,1,0.36,1)] sm:group-hover:opacity-100 sm:group-hover:translate-y-0 inline-flex items-center gap-1.5">
                  Learn More
                  <span aria-hidden="true" class="relative inline-block h-[1em] w-[1.2em] overflow-hidden">
                    <span class="absolute inset-0 flex items-center justify-center transition-transform duration-[450ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover/learn:translate-x-[140%]">→</span>
                    <span class="absolute inset-0 flex items-center justify-center -translate-x-[140%] transition-transform duration-[450ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover/learn:translate-x-0">→</span>
                  </span>
                </span>
              </div>
            </button>
          </li>
        ))
      }
    </ul>

    {/* Empty state — shown when filter has no matches */}
    <p
      data-investments-empty
      class="hidden body-l opacity-70 text-[var(--color-text)] text-center"
    >
      No investments match this filter.
    </p>
  </div>
</section>

<!-- ── Investment detail modal ──────────────────────────────── -->
<!--
  One modal instance, content swapped per click.
  Layout: logo → name → date + status → description → acquisitions → news → website
-->
<div
  id="inv-modal"
  data-inv-modal
  class="fixed inset-0 z-[55] hidden items-center justify-center p-4 sm:p-8"
  aria-hidden="true"
  style="display:none;"
>
  <!-- Backdrop -->
  <div
    data-inv-backdrop
    class="fixed inset-0 bg-[rgba(32,56,100,0.85)]"
    style="backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);"
  ></div>

  <!-- Card -->
  <article
    data-inv-card
    role="dialog"
    aria-modal="true"
    aria-labelledby="inv-modal-name"
    class="relative bg-white rounded-[10px] shadow-2xl w-full overflow-y-auto"
    style="max-width: min(960px, calc(100vw - 32px)); max-height: calc(100vh - 64px); -webkit-overflow-scrolling: touch; overscroll-behavior: contain;"
  >
    <!-- Close button — plain X, top-right -->
    <button
      type="button"
      data-inv-close
      aria-label="Close"
      class="absolute top-5 right-5 inline-flex h-8 w-8 items-center justify-center text-[var(--color-text)] hover:text-[var(--color-primary)] transition-colors z-10"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </button>

    <div class="p-8 sm:p-10">

      <!-- Top row: logo in bordered box (left) + name & meta (right) -->
      <div class="flex flex-col sm:flex-row gap-6 sm:gap-8">

        <!-- Logo box — matches the card tile style -->
        <div
          class="flex items-center justify-center rounded-[10px] border border-[var(--color-primary-20)] bg-white shrink-0"
          style="width: 200px; min-height: 120px; padding: 20px;"
        >
          <img
            data-inv-logo-img
            src=""
            alt=""
            class="h-auto w-auto object-contain"
            style="max-height: 80px; max-width: 160px;"
          />
        </div>

        <!-- Name + date/status — vertically centered beside logo -->
        <div class="flex-1 min-w-0 flex flex-col justify-center">
          <h2
            id="inv-modal-name"
            data-inv-name
            class="h3-accent text-[var(--color-text)]"
          ></h2>
          <p class="mt-3 body-l text-[var(--color-text)] opacity-60">
            <span data-inv-date class="hidden"><span data-inv-date-val></span>&ensp;|&ensp;</span>Status:&ensp;<span data-inv-status-val></span>
          </p>
        </div>
      </div>

      <!-- Description — full width below the top row -->
      <div data-inv-body class="mt-6 flex flex-col gap-4 body-l text-[var(--color-text)]"></div>

      <!-- Platform Acquisitions — full width below -->
      <div data-inv-acquisitions class="mt-8 hidden">
        <p class="text-[11px] font-semibold tracking-[1.32px] uppercase text-[var(--color-primary)] mb-4">
          Platform Acquisitions
        </p>
        <div data-inv-acq-logos class="flex flex-wrap items-center gap-4"></div>
      </div>

      <!-- Related News — full width below -->
      <div data-inv-news class="mt-8 hidden">
        <p class="text-[11px] font-semibold tracking-[1.32px] uppercase text-[var(--color-primary)] mb-4">
          Related News
        </p>
        <ul data-inv-news-list class="flex flex-col gap-2"></ul>
      </div>

      <!-- Website — full width below -->
      <p data-inv-website class="mt-6 body-l tracking-[1px] text-[var(--color-text)] hidden">
        <strong>Website:</strong>&nbsp;&nbsp;<a
          data-inv-website-link
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="underline hover:text-[var(--color-primary)] transition-colors"
        ></a>
      </p>

    </div>
  </article>
</div>

<!-- Investment + article data for modal lookup -->
<script id="inv-modal-data" type="application/json" set:html={JSON.stringify(modalData)} />

<style is:global>
  /*
    Learn More underline — background-image gradient approach so it
    can't be clipped by an inline-flex parent.
  */
  .learn-more-label {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: left bottom;
    background-size: 0% 1px;
    padding-bottom: 4px;
    transition: background-size 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .learn-more-label:hover {
    background-size: 100% 1px;
  }

  /*
    Pre-hide investment cards so they don't flash before GSAP reveal.
    Targeting button (was anchor).
  */
  [data-investment-card] > button {
    opacity: 0;
    transform: translateY(24px);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-investment-card] > button {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import { setupBatchReveal, gsap } from "@lib/animations";
  import type { Investment } from "@content";

  // ── Scroll-triggered card reveal ──
  setupBatchReveal("[data-investment-card] > button", {
    y: 24,
    stagger: 0.05,
    start: "top 92%",
  });

  // ── Data ──
  const dataScript = document.getElementById("inv-modal-data");
  const parsed = dataScript ? JSON.parse(dataScript.textContent || "{}") : {};
  const investments: Record<string, Investment> = parsed.investments ?? {};
  const articles: Record<string, { title: string; slug: string }> = parsed.articles ?? {};

  // ── Modal DOM refs ──
  const modal       = document.querySelector<HTMLElement>("[data-inv-modal]");
  const card        = document.querySelector<HTMLElement>("[data-inv-card]");
  const backdrop    = document.querySelector<HTMLElement>("[data-inv-backdrop]");
  const closeBtn    = document.querySelector<HTMLButtonElement>("[data-inv-close]");
  const elLogoImg   = document.querySelector<HTMLImageElement>("[data-inv-logo-img]");
  const elName      = document.querySelector<HTMLElement>("[data-inv-name]");
  const elDate      = document.querySelector<HTMLElement>("[data-inv-date]");  // the wrapper span
  const elDateVal   = document.querySelector<HTMLElement>("[data-inv-date-val]");
  const elStatusVal = document.querySelector<HTMLElement>("[data-inv-status-val]");
  const elBody      = document.querySelector<HTMLElement>("[data-inv-body]");
  const elAcq       = document.querySelector<HTMLElement>("[data-inv-acquisitions]");
  const elAcqLogos  = document.querySelector<HTMLElement>("[data-inv-acq-logos]");
  const elNews      = document.querySelector<HTMLElement>("[data-inv-news]");
  const elNewsList  = document.querySelector<HTMLElement>("[data-inv-news-list]");
  const elWebsite   = document.querySelector<HTMLElement>("[data-inv-website]");
  const elWebsiteLink = document.querySelector<HTMLAnchorElement>("[data-inv-website-link]");

  // Hide hamburger while modal is open (hamburger is z-[60], modal is z-[55])
  const mobileToggle = document.querySelector<HTMLElement>("[data-mobile-toggle]");

  let lastFocused: HTMLElement | null = null;

  const open = (slug: string, trigger: HTMLElement) => {
    const inv = investments[slug];
    if (!inv || !modal || !elName || !elBody) return;

    lastFocused = trigger;
    if (mobileToggle) mobileToggle.style.display = "none";

    // Logo
    if (elLogoImg) {
      elLogoImg.src = inv.logo;
      elLogoImg.alt = inv.name;
    }

    // Name
    elName.textContent = inv.name;

    // Investment Date (span wrapper shows/hides; includes trailing separator)
    if (elDate && elDateVal) {
      if (inv.platformInvestmentDate) {
        elDateVal.textContent = `Investment Date: ${inv.platformInvestmentDate}`;
        elDate.classList.remove("hidden");
      } else {
        elDate.classList.add("hidden");
      }
    }

    // Status
    if (elStatusVal) {
      elStatusVal.textContent = inv.status === "active" ? "Active" : "Realized";
    }

    // Description — explicit body-l class so font/size/tracking are set directly,
    // not inherited (inheritance can be fragile for dynamically-injected markup).
    elBody.innerHTML = (inv.description ?? [])
      .map((p) => `<p class="body-l text-[var(--color-text)]">${escapeHtml(p)}</p>`)
      .join("");

    // Platform Acquisitions
    if (elAcq && elAcqLogos) {
      const acqs = inv.acquisitions ?? [];
      if (acqs.length > 0) {
        elAcqLogos.innerHTML = acqs
          .map(
            (a) =>
              `<div class="flex items-center justify-center rounded-[10px] bg-white border border-[rgba(32,56,100,0.15)] p-4" style="height:80px;width:200px;" title="${escapeHtml(a.name)}">` +
              `<img src="${escapeHtml(a.logo)}" alt="${escapeHtml(a.name)}" class="object-contain" style="max-height:44px;max-width:144px;" loading="lazy" />` +
              `</div>`
          )
          .join("");
        elAcq.classList.remove("hidden");
      } else {
        elAcqLogos.innerHTML = "";
        elAcq.classList.add("hidden");
      }
    }

    // Related News
    if (elNews && elNewsList) {
      const internalNews = (inv.relatedNews ?? [])
        .map((s) => articles[s])
        .filter(Boolean);
      const externalNews = inv.externalNews ?? [];

      if (internalNews.length > 0 || externalNews.length > 0) {
        const internalHtml = internalNews
          .map(
            (a) =>
              `<li><a href="/news/${escapeHtml(a.slug)}" class="body-l tracking-[1px] text-[var(--color-text)] underline hover:text-[var(--color-primary)] transition-colors">${escapeHtml(a.title)}</a></li>`
          )
          .join("");
        const externalHtml = externalNews
          .map(
            (item) =>
              `<li><a href="${escapeHtml(item.url)}" target="_blank" rel="noopener noreferrer" class="body-l text-[var(--color-text)] underline hover:text-[var(--color-primary)] transition-colors inline-flex items-start gap-2 group">` +
              `<span class="mt-[5px] shrink-0 opacity-50 group-hover:opacity-100 transition-opacity">↗</span>` +
              `<span>${escapeHtml(item.title)}</span></a></li>`
          )
          .join("");
        elNewsList.innerHTML = internalHtml + externalHtml;
        elNews.classList.remove("hidden");
      } else {
        elNewsList.innerHTML = "";
        elNews.classList.add("hidden");
      }
    }

    // Website
    if (elWebsite && elWebsiteLink) {
      if (inv.website) {
        elWebsiteLink.href = inv.website;
        elWebsiteLink.textContent = inv.website.replace(/^https?:\/\//, "");
        elWebsite.classList.remove("hidden");
      } else {
        elWebsite.classList.add("hidden");
      }
    }

    // Show modal
    modal.style.display = "flex";
    modal.setAttribute("aria-hidden", "false");
    if (card) card.scrollTop = 0;

    // Lock background scroll (position:fixed is the only reliable cross-browser
    // technique; overflow:hidden on html doesn't stop wheel scroll in Chrome).
    const scrollY = window.scrollY;
    document.documentElement.dataset.invScrollY = String(scrollY);
    document.body.style.position = "fixed";
    document.body.style.top = `-${scrollY}px`;
    document.body.style.width = "100%";

    // Animate in
    gsap.fromTo(backdrop, { opacity: 0 }, { opacity: 1, duration: 0.3, ease: "power2.out" });
    gsap.fromTo(
      card,
      { opacity: 0, y: 24, scale: 0.98 },
      { opacity: 1, y: 0, scale: 1, duration: 0.5, ease: "expo.out" }
    );

    requestAnimationFrame(() => closeBtn?.focus());
  };

  const close = () => {
    if (!modal) return;
    gsap.to(card, { opacity: 0, y: 16, scale: 0.98, duration: 0.3, ease: "power2.in" });
    gsap.to(backdrop, {
      opacity: 0,
      duration: 0.3,
      ease: "power2.in",
      onComplete: () => {
        modal.style.display = "none";
        modal.setAttribute("aria-hidden", "true");
        document.body.style.position = "";
        document.body.style.top = "";
        document.body.style.width = "";
        const savedY = parseInt(document.documentElement.dataset.invScrollY ?? "0", 10);
        window.scrollTo(0, savedY);
        if (mobileToggle) mobileToggle.style.display = "";
        lastFocused?.focus();
      },
    });
  };

  // Wire card triggers
  document.querySelectorAll<HTMLButtonElement>("[data-inv-trigger]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const slug = btn.dataset.slug;
      if (slug) open(slug, btn);
    });
  });

  closeBtn?.addEventListener("click", close);
  backdrop?.addEventListener("click", close);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal?.getAttribute("aria-hidden") === "false") close();
  });

  // The body is position:fixed while the modal is open (stops background scroll),
  // but that causes the browser to discard wheel events instead of routing them
  // to the card. Fix: intercept wheel on the card and manually apply the scroll.
  card?.addEventListener("wheel", (e) => {
    e.preventDefault();
    // deltaMode: 0=px, 1=lines (~40px each), 2=pages
    const delta = e.deltaMode === 1 ? e.deltaY * 40 : e.deltaMode === 2 ? e.deltaY * (card.clientHeight || 600) : e.deltaY;
    card.scrollTop += delta;
  }, { passive: false });

  // ── Filter logic ──
  const filterBtns = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const gridCards  = document.querySelectorAll<HTMLElement>("[data-investment-card]");
  const emptyState = document.querySelector<HTMLElement>("[data-investments-empty]");

  const setFilter = (filter: string) => {
    let visible = 0;
    gridCards.forEach((gc) => {
      const status = gc.dataset.status ?? "active";
      const show = filter === "all" || status === filter;
      const triggerBtn = gc.querySelector<HTMLButtonElement>("button");
      if (triggerBtn) {
        if (show) {
          triggerBtn.style.display = "";
          gsap.to(triggerBtn, { opacity: 1, y: 0, duration: 0.5, ease: "expo.out", overwrite: true });
        } else {
          gsap.set(triggerBtn, { opacity: 0, y: 16 });
          triggerBtn.style.display = "none";
        }
      }
      if (show) visible++;
    });
    emptyState?.classList.toggle("hidden", visible > 0);
  };

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter ?? "all";

      filterBtns.forEach((b) => {
        const active = b === btn;
        b.setAttribute("aria-selected", active ? "true" : "false");
        b.classList.toggle("bg-[var(--color-primary)]", active);
        b.classList.toggle("text-[var(--color-bg)]", active);
        b.classList.toggle("bg-[var(--color-bg)]", !active);
        b.classList.toggle("text-[var(--color-primary)]", !active);
        b.classList.toggle("hover:bg-[var(--color-tertiary)]", !active);
      });

      setFilter(filter);
    });
  });

  // Tiny HTML escaper
  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }
</script>
