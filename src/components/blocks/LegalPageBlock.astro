---
/**
 * Legal Page — Privacy Policy / Terms of Use / Cookie Policy.
 *
 * Per Figma frame 8243:4188:
 *   – Light bg
 *   – Hero: title + divider + effective date + intro paragraphs (max-width 820px)
 *   – Two-column section: article (left) + sticky TOC card (right)
 *   – Each article section: H2 heading + content (paragraphs / bullet lists) + horizontal rule below
 *   – Sticky TOC: bordered card, "ON THIS SECTION" caption, page title (H4), then list of section links
 *   – TOC links scroll smoothly to anchored sections
 */
import type { LegalPageBlock } from "@content";

type Props = LegalPageBlock;
const { title, effectiveDate, intro, sections } = Astro.props;

// Auto-generate URL-friendly anchor ids for each section so the TOC can link to them.
const slugify = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const sectionsWithIds = sections.map((s) => ({ ...s, id: slugify(s.heading) }));
---

{/* ── Hero: title + divider + effective date + intro ─────────── */}
<section class="bg-[var(--color-bg)] section pt-12 lg:pt-16">
  <div class="container-max max-w-[820px]">
    <h1 data-legal-title class="h1 text-[var(--color-text)]">{title}</h1>
    <span data-legal-divider class="mt-6 block h-[2px] w-[190px] bg-[var(--color-text)] origin-left"></span>
    {
      effectiveDate && (
        <p data-legal-date class="mt-6 body-s text-[var(--color-text)]">
          Effective Date: {effectiveDate}
        </p>
      )
    }
    {
      intro.map((p) => (
        <p data-legal-intro class="mt-4 body-l text-[var(--color-text)]">
          {p}
        </p>
      ))
    }
  </div>
</section>

{/* ── Article + sticky TOC ───────────────────────────────────── */}
<section class="bg-[var(--color-bg)] section">
  <div class="container-max grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:gap-16">
    {/* Article column */}
    <article class="flex flex-col gap-8">
      {
        sectionsWithIds.map((section) => (
          <section
            id={section.id}
            data-legal-section
            class="flex flex-col gap-4 pb-5 border-b border-[var(--color-tertiary)] last:border-b-0"
          >
            <h2 class="font-display text-[clamp(26px,2.6vw,36px)] leading-tight text-[var(--color-text)]">
              {section.heading}
            </h2>
            <div class="flex flex-col gap-4 text-[var(--color-text)]">
              {section.content.map((c) => {
                if (c.kind === "spacer") return <div class="h-2" />;
                if (c.kind === "list") {
                  return (
                    <ul class="list-disc pl-7 flex flex-col gap-1 body-l">
                      {c.items.map((item) => (
                        <li>
                          <Fragment set:html={item} />
                        </li>
                      ))}
                    </ul>
                  );
                }
                return <p class="body-l" set:html={c.html} />;
              })}
            </div>
          </section>
        ))
      }
    </article>

    {/* Sticky TOC sidebar */}
    <aside data-legal-toc class="hidden lg:block">
      <div
        class="sticky border border-[var(--color-tertiary)] rounded-[10px] p-6 flex flex-col gap-6"
        style="top: clamp(96px, 12vh, 140px);"
      >
        <p class="text-[11px] font-semibold tracking-[1.32px] uppercase text-[var(--color-primary)]">
          On This Section
        </p>
        <div class="flex flex-col gap-4">
          <h3 class="font-display text-[clamp(22px,2vw,26px)] leading-tight text-[var(--color-primary)]">
            {title}
          </h3>
          <ul class="flex flex-col gap-3">
            {
              sectionsWithIds.map((s) => (
                <li>
                  <a
                    href={`#${s.id}`}
                    data-toc-link
                    class="body-l tracking-[1px] text-[var(--color-text)] hover:text-[var(--color-primary)] transition-colors"
                  >
                    {s.heading}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </aside>
  </div>
</section>

<style>
  /*
    Hero entrance animations — CSS-driven so they don't flicker on load.
    Article sections still use scroll-triggered reveal via JS below.
  */
  [data-legal-title],
  [data-legal-divider],
  [data-legal-date],
  [data-legal-intro] {
    opacity: 0;
    animation-fill-mode: forwards;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  }
  [data-legal-title] {
    transform: translateY(24px);
    animation-name: legal-fade-up;
    animation-duration: 1s;
  }
  [data-legal-divider] {
    transform: scaleX(0);
    transform-origin: left center;
    animation-name: legal-divider-draw;
    animation-duration: 1.1s;
    animation-delay: 0.4s;
  }
  [data-legal-date] {
    transform: translateY(16px);
    animation-name: legal-fade-up;
    animation-duration: 0.9s;
    animation-delay: 0.4s;
  }
  [data-legal-intro] {
    transform: translateY(16px);
    animation-name: legal-fade-up;
    animation-duration: 0.9s;
    animation-delay: 0.48s;
  }
  @keyframes legal-fade-up {
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes legal-divider-draw {
    to { opacity: 1; transform: scaleX(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-legal-title],
    [data-legal-divider],
    [data-legal-date],
    [data-legal-intro] {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>

<script>
  import { setupBatchReveal } from "@lib/animations";

  // Hero reveals are CSS-driven (see <style> above).
  // Each article section reveals as it enters the viewport
  setupBatchReveal("[data-legal-section]", { y: 24, stagger: 0.06, start: "top 92%" });

  // Smooth-scroll TOC links with offset for the sticky header
  document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]").forEach((link) => {
    link.addEventListener("click", (e) => {
      const id = link.getAttribute("href")?.slice(1);
      if (!id) return;
      const target = document.getElementById(id);
      if (!target) return;
      e.preventDefault();
      const headerOffset = 100; // accommodate the fixed page header
      const top = target.getBoundingClientRect().top + window.scrollY - headerOffset;
      window.scrollTo({ top, behavior: "smooth" });
      // Update URL hash without jumping
      history.replaceState(null, "", `#${id}`);
    });
  });
</script>
