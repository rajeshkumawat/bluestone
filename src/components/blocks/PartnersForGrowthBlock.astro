---
import type { PartnersForGrowthBlock } from "@content";
import Button from "@components/ui/Button.astro";

type Props = PartnersForGrowthBlock;
const { title, body, cta, bgImage } = Astro.props;
---

<section
  data-block="partners-for-growth"
  class="section relative isolate overflow-hidden text-white"
>
  <!-- Parallax bg image -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div data-partners-bg class="absolute inset-0 will-change-transform">
      <img src={bgImage} alt="" class="absolute inset-0 h-full w-full object-cover" style="transform: scale(1.12);" />
    </div>
    <div class="absolute inset-0 bg-[var(--color-primary-50)]"></div>
    <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(32,56,100,0.2) 0%, rgba(32,56,100,0.6) 100%);"></div>
  </div>

  <div class="container-max grid gap-12 lg:grid-cols-2 lg:gap-20 py-20">
    <h2 data-partners-title class="h2 text-white">{title}</h2>

    <div class="flex flex-col gap-6 lg:pt-32">
      <p data-partners-body class="body-l max-w-[44ch]">{body}</p>
      <div data-partners-cta>
        <Button {...cta} />
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from "@lib/animations";

  // Parallax bg
  const bg = document.querySelector<HTMLElement>("[data-partners-bg] img");
  if (bg) {
    gsap.fromTo(
      bg,
      { yPercent: -8, scale: 1.12 },
      {
        yPercent: 14,
        scale: 1.18,
        ease: "none",
        scrollTrigger: {
          trigger: "[data-block='partners-for-growth']",
          start: "top bottom",
          end: "bottom top",
          scrub: true,
        },
      },
    );
  }

  // Title: slide in from left with mask
  gsap.from("[data-partners-title]", {
    opacity: 0,
    x: -40,
    duration: 1.1,
    ease: "expo.out",
    scrollTrigger: { trigger: "[data-partners-title]", start: "top 85%", once: true },
  });

  // Body: whole-paragraph fade-up
  gsap.from("[data-partners-body]", {
    opacity: 0,
    y: 24,
    duration: 1.0,
    delay: 0.15,
    ease: "expo.out",
    scrollTrigger: { trigger: "[data-partners-body]", start: "top 85%", once: true },
  });

  gsap.from("[data-partners-cta]", {
    opacity: 0,
    y: 16,
    duration: 0.8,
    ease: "expo.out",
    delay: 0.4,
    scrollTrigger: { trigger: "[data-partners-cta]", start: "top 90%", once: true },
  });
</script>
