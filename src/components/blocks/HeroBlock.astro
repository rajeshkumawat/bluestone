---
import type { HeroBlock } from "@content";

type Props = HeroBlock;
const { variant = "fullscreen", titleSegments, bgImage, bgVideoMp4, bgVideoWebm, overlayImage, overlayStrength = "default" } = Astro.props;
const hasVideo = Boolean(bgVideoMp4 || bgVideoWebm);
const isCompact = variant === "compact";

// Two gradient profiles — Home defaults to a heavier wash; About passes
// `overlayStrength: "light"` so its already-dark footage isn't muted.
const overlayGradient =
  overlayStrength === "light"
    ? "linear-gradient(180deg, rgba(32,56,100,0.45) 0%, rgba(32,56,100,0.70) 100%)"
    : "linear-gradient(180deg, rgba(32,56,100,0.62) 0%, rgba(32,56,100,0.90) 100%)";

/**
 * Split title segments into individual words so each word can reveal
 * independently for a cinematic stagger. Each word keeps its italic
 * flag. `{ br: true }` segments become forced line breaks.
 */
type Word = { kind: "word"; text: string; italic: boolean } | { kind: "br" };
const words: Word[] = titleSegments.flatMap<Word>((seg) => {
  if (typeof seg === "object" && "br" in seg) return [{ kind: "br" }];
  const isItalic = typeof seg !== "string";
  const text = typeof seg === "string" ? seg : seg.em;
  return text
    .split(/(\s+)/) // keep spaces as separators
    .filter((w) => w.length > 0)
    .map<Word>((w) => ({ kind: "word", text: w, italic: isItalic }));
});
---

<section data-block="hero" class="relative isolate overflow-hidden bg-[var(--color-primary)] text-white">
  <!-- ── Background layers ─────────────────────────────── -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <!--
      Background media — scrubbed for parallax + slow zoom.
      No poster image: the section's navy bg shows behind the video
      while it loads, so there's no flash of a still photo before
      playback. Same fallback for prefers-reduced-motion users
      (video pauses → navy + gradient + stars remains visible).
    -->
    <div data-hero-bg class="absolute inset-0 will-change-transform">
      {
        hasVideo && (
          <video
            data-hero-video
            class="absolute inset-0 h-full w-full object-cover"
            style="transform: scale(1.15);"
            autoplay
            muted
            loop
            playsinline
            preload="auto"
            disablepictureinpicture
            disableremoteplayback
          >
            {bgVideoWebm && <source src={bgVideoWebm} type="video/webm" />}
            {bgVideoMp4 && <source src={bgVideoMp4} type="video/mp4" />}
          </video>
        )
      }
    </div>

    {
      overlayImage && (
        <img
          src={overlayImage}
          alt=""
          class="absolute inset-0 h-full w-full object-cover mix-blend-screen opacity-70"
        />
      )
    }

    <!--
      Navy darkening gradient. Two preset strengths configurable per
      page via the `overlayStrength` prop on the Hero block:
      – "default" (Home): 62% → 90%
      – "light"   (About): 45% → 70%
    -->
    <div
      class="absolute inset-0"
      style={`background: ${overlayGradient};`}
    >
    </div>

    <!-- Animated star twinkle layer (CSS only, ultra cheap) -->
    <div class="absolute inset-0 hero-stars opacity-50 mix-blend-screen pointer-events-none"></div>
  </div>

  <!-- ── Content ───────────────────────────────────────── -->
  <!--
    Layout:
    – fullscreen variant (Home): min-height 100vh, padding-block ~240px
    – compact variant (About/Team/etc): min-height ~60vh, smaller padding
    – justify-center pushes the headline to the vertical centre
    – the headline wraps naturally; no max-width constraint so the
      italic emphasis can sit on the same line as the lead-in
  -->
  <div
    class:list={[
      "relative container-max flex flex-col justify-center",
      isCompact ? "min-h-[60vh]" : "min-h-screen",
    ]}
    style={
      isCompact
        ? "padding-inline: clamp(20px, 5.5vw, 80px); padding-block: clamp(120px, 14vw, 180px);"
        : "padding-inline: clamp(20px, 5.5vw, 80px); padding-block: clamp(140px, 18vw, 240px);"
    }
  >
    <h1
      data-hero-title
      class="h1 text-white"
      style="font-feature-settings: 'liga' 1, 'kern' 1;"
    >
      {
        words.map((w) => {
          // Forced line break — drop the next segment to a new line.
          if (w.kind === "br") return <br />;
          // Whitespace stays as a plain text node so words can wrap.
          if (/^\s+$/.test(w.text)) return <>{" "}</>;
          if (w.italic) return <em>{w.text}</em>;
          return <>{w.text}</>;
        })
      }
    </h1>

    <!-- Divider that draws on (per Figma: 190.5px wide, 1.5px stroke) -->
    <div class="mt-6">
      <span data-hero-divider class="block h-[2px] w-[190px] bg-white origin-left"></span>
    </div>
  </div>
</section>

<style>
  /* ── Headline reveal: whole-title fade-up ── */
  [data-hero-title] {
    opacity: 0;
    transform: translateY(28px);
    will-change: transform, opacity;
    animation: hero-title-in 1.1s cubic-bezier(0.19, 1, 0.22, 1) 0.15s forwards;
  }
  @keyframes hero-title-in {
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── Starfield: layered radial gradients, drifts slowly ── */
  .hero-stars {
    background-image:
      radial-gradient(1px 1px at 20% 30%, white, transparent 50%),
      radial-gradient(1px 1px at 80% 60%, white, transparent 50%),
      radial-gradient(1px 1px at 40% 80%, white, transparent 50%),
      radial-gradient(1.5px 1.5px at 65% 20%, white, transparent 50%),
      radial-gradient(1px 1px at 10% 70%, white, transparent 50%),
      radial-gradient(1.5px 1.5px at 90% 40%, white, transparent 50%),
      radial-gradient(1px 1px at 50% 50%, white, transparent 50%);
    background-size: 600px 600px;
    animation: drift 60s linear infinite;
  }
  @keyframes drift {
    from { background-position: 0 0; }
    to   { background-position: 600px 600px; }
  }

  /*
    Divider draw-on — CSS-driven so it doesn't flash. Starts hidden
    (scale-x: 0), fires after the headline words finish (~1.1s).
  */
  [data-hero-divider] {
    transform: scaleX(0);
    transform-origin: left center;
    animation: hero-divider-in 1.2s cubic-bezier(0.19, 1, 0.22, 1) 1.1s forwards;
  }
  @keyframes hero-divider-in {
    to { transform: scaleX(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-hero-title] { animation: none; opacity: 1; transform: none; }
    .hero-stars { animation: none; }
    [data-hero-divider] { animation: none; transform: none; }
  }
</style>

<script>
  import { gsap, ScrollTrigger } from "@lib/animations";

  // ── Slow zoom + parallax on the hero bg (works for <img> or <video>) ──
  const bg = document.querySelector<HTMLElement>(
    "[data-hero-bg] img, [data-hero-bg] video",
  );
  if (bg) {
    gsap.to(bg, {
      yPercent: 18,
      scale: 1.28,
      ease: "none",
      scrollTrigger: {
        trigger: "[data-block='hero']",
        start: "top top",
        end: "bottom top",
        scrub: 0.8,
      },
    });
  }

  // ── Reduced-motion handling for video ──
  // If the user prefers reduced motion, pause the video so they only
  // see the poster image (no animation).
  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  if (video) {
    const mq = window.matchMedia("(prefers-reduced-motion: reduce)");
    const apply = () => {
      if (mq.matches) video.pause();
      else video.play().catch(() => {});
    };
    apply();
    mq.addEventListener("change", apply);

    // Also pause when the section scrolls fully out of view to save battery
    ScrollTrigger.create({
      trigger: "[data-block='hero']",
      start: "top top",
      end: "bottom top",
      onLeave: () => video.pause(),
      onEnterBack: () => {
        if (!mq.matches) video.play().catch(() => {});
      },
    });
  }

  // Divider entrance is CSS-driven (see <style> above) — no GSAP needed.
</script>
