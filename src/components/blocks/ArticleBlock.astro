---
/**
 * Article — sidebar (date) + main article (title + summary + "View Article" CTA).
 *
 * Layout per client spec (May 2026 revision):
 *   – Sidebar: just the formatted date (no category pill, no read time)
 *   – Main: title + short summary + CTA that opens externalUrl in a new tab
 *
 * If no externalUrl is set the CTA is hidden. The body sections are kept
 * for any article that needs full inline content instead of an external link.
 */
import type { ArticleBlock } from "@content";
import { getArticleBySlug } from "@content";

type Props = ArticleBlock;
const { slug } = Astro.props;

const article = await getArticleBySlug(slug);
if (!article) throw new Error(`article not found: ${slug}`);

const date = new Date(article.publishedAt).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<section data-block="article" class="section bg-[var(--color-bg)]">
  <div class="container-max grid gap-10 md:grid-cols-[280px_1fr] md:gap-16 lg:gap-20 max-w-[1100px] mx-auto">
    {/* Sidebar — source chip + date + read time */}
    <aside data-article-meta class="flex flex-col gap-4">
      <hr class="border-0 border-t border-[var(--color-primary-50)] w-full" />
      {(article.source || article.category) && (
        <span class="self-start inline-flex items-center px-3 py-1 rounded-full bg-[var(--color-tertiary)] border border-[var(--color-primary-20)] body-s text-[var(--color-primary)] tracking-[1px]">
          {article.source ?? article.category}
        </span>
      )}
      <p class="body-l tracking-[1px] text-[var(--color-text)] whitespace-nowrap">
        {date}{article.readMinutes ? ` · ${article.readMinutes} min read` : ""}
      </p>
    </aside>

    {/* Main article */}
    <article data-article-body class="flex flex-col gap-6 min-w-0">
      <h1
        data-article-title
        class="font-display text-[clamp(26px,3vw,40px)] leading-[1.1] text-[var(--color-primary)]"
      >
        {article.title}
      </h1>

      {/* Optional full body sections (kept for future use) */}
      {
        (article.body ?? []).map((section) => (
          <div data-article-section class="flex flex-col gap-4">
            {section.heading && (
              <h2 class="font-display text-[clamp(24px,2.6vw,36px)] leading-tight text-[var(--color-primary)]">
                {section.heading}
              </h2>
            )}
            {section.paragraphs.map((p) => (
              <p class="body-l text-[var(--color-text)]">{p}</p>
            ))}
          </div>
        ))
      }

      {/* "View Article" CTA — only when externalUrl is set */}
      {
        article.externalUrl && (
          <div class="mt-4">
            <a
              href={article.externalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center justify-center gap-2 rounded-[4px] bg-[var(--color-primary)] text-[var(--color-bg)] body-l tracking-[1px] px-10 py-5 cursor-pointer transition-[transform,box-shadow,background-color] duration-300 ease-out shadow-[0_20px_25px_-5px_rgba(0,0,0,0.10),0_8px_10px_-6px_rgba(0,0,0,0.10)] hover:-translate-y-0.5 hover:shadow-[0_25px_30px_-5px_rgba(0,0,0,0.18),0_10px_12px_-6px_rgba(0,0,0,0.12)]"
            >
              <span>View Article</span>
              <svg
                width="18"
                height="18"
                viewBox="0 0 18 18"
                fill="none"
                aria-hidden="true"
                class="transition-transform duration-300 ease-out group-hover:translate-x-1"
              >
                <path
                  d="M3 9h12M10 4l5 5-5 5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          </div>
        )
      }
    </article>
  </div>
</section>

<style>
  /*
    Entrance animations — CSS-driven (no GSAP flash). Body sections
    still use scroll-trigger in <script> below.
  */
  [data-article-meta],
  [data-article-title] {
    opacity: 0;
    animation-fill-mode: forwards;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  }
  [data-article-meta] {
    transform: translateY(16px);
    animation-name: article-fade-up;
    animation-duration: 0.9s;
  }
  [data-article-title] {
    transform: translateY(24px);
    animation-name: article-fade-up;
    animation-duration: 1s;
    animation-delay: 0.1s;
  }
  @keyframes article-fade-up {
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-article-meta],
    [data-article-title] {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>

<script>
  import { gsap } from "@lib/animations";

  // Meta + title entrances are CSS-driven. Body sections stay JS-driven
  // because they're scroll-triggered (depend on viewport position).
  gsap.utils.toArray<HTMLElement>("[data-article-section]").forEach((el, i) => {
    gsap.from(el, {
      opacity: 0,
      y: 20,
      duration: 0.8,
      delay: 0.2 + i * 0.05,
      ease: "expo.out",
      scrollTrigger: { trigger: el, start: "top 90%", once: true },
    });
  });
</script>
