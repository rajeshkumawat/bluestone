---
/**
 * Contact — title + divider + info list (left) and form (right).
 *
 * Per Figma frame 8243:4339:
 *   – Tertiary bg fills the section
 *   – 5-column grid: cols 1–2 (40 %) = left, cols 3–5 (60 %) = form
 *   – Form: Full Name + Email row, Subject, Message, Submit
 *   – Submit is full-width navy button with arrow
 *
 * Backend: NOT wired yet. Submit redirects to /thank-you on success.
 * When the backend is in place (Formspree / Resend / Cloudflare Worker),
 * fetch() the endpoint, then redirect on success — the swap point is
 * marked below in the submit handler.
 */
import type { ContactBlock } from "@content";

type Props = ContactBlock;
const { title, info } = Astro.props;
---

<section data-block="contact" class="bg-white">
  <div
    class="container-max grid gap-12 lg:grid-cols-5 lg:gap-12"
    style="padding-inline: clamp(20px, 5.5vw, 80px); padding-block: clamp(48px, 6vw, 80px);"
  >
    {/* Left: title + divider + contact info */}
    <div data-contact-info class="lg:col-span-2 flex flex-col justify-between gap-12">
      <div>
        <h1 data-contact-title class="h1 text-[var(--color-text)]">{title}</h1>
        <span
          data-contact-divider
          class="mt-6 block h-[2px] w-[190px] bg-[var(--color-text)] origin-left"
        ></span>
      </div>

      <ul class="flex flex-col gap-6 max-w-[440px]">
        {
          info.map((item) => (
            <li class="flex flex-col gap-2">
              <span class="body-l tracking-[1px] text-[rgba(32,56,100,0.6)]">{item.label}</span>
              {item.href ? (
                <a
                  href={item.href}
                  class="body-l tracking-[1px] text-[var(--color-text)] hover:text-[var(--color-primary)] transition-colors whitespace-pre-line"
                >
                  {item.value}
                </a>
              ) : (
                <span class="body-l tracking-[1px] text-[var(--color-text)] whitespace-pre-line">{item.value}</span>
              )}
            </li>
          ))
        }
      </ul>
    </div>

    {/* Right: form */}
    <form
      data-contact-form
      class="lg:col-span-3 flex flex-col gap-6"
      novalidate
    >
      <div class="grid gap-6 sm:grid-cols-2">
        <div class="flex flex-col gap-2">
          <label for="contact-name" class="body-l tracking-[1px] text-[var(--color-text)]">
            Full Name <span aria-hidden="true">*</span>
            <span class="sr-only">(required)</span>
          </label>
          <input
            id="contact-name"
            name="name"
            type="text"
            required
            placeholder="Your full name"
            class="contact-input"
          />
        </div>
        <div class="flex flex-col gap-2">
          <label for="contact-email" class="body-l tracking-[1px] text-[var(--color-text)]">
            Email <span aria-hidden="true">*</span>
            <span class="sr-only">(required)</span>
          </label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            placeholder="Your email address"
            class="contact-input"
          />
        </div>
      </div>

      <div class="flex flex-col gap-2">
        <label for="contact-subject" class="body-l tracking-[1px] text-[var(--color-text)]">
          Subject
        </label>
        <input
          id="contact-subject"
          name="subject"
          type="text"
          placeholder="Your subject"
          class="contact-input"
        />
      </div>

      <div class="flex flex-col gap-2">
        <label for="contact-message" class="body-l tracking-[1px] text-[var(--color-text)]">
          Message <span aria-hidden="true">*</span>
          <span class="sr-only">(required)</span>
        </label>
        <textarea
          id="contact-message"
          name="message"
          required
          rows="6"
          placeholder="Start writing..."
          class="contact-input resize-y"></textarea>
      </div>

      {/* Status message — shown after submit */}
      <p
        data-contact-status
        role="status"
        aria-live="polite"
        class="body-m hidden"
      ></p>

      <button
        type="submit"
        data-contact-submit
        class="group inline-flex items-center justify-center gap-2 rounded-[4px] bg-[var(--color-primary)] text-[var(--color-bg)] body-l tracking-[1px] px-10 py-5 cursor-pointer transition-[transform,box-shadow,background-color] duration-300 ease-out shadow-[0_20px_25px_-5px_rgba(0,0,0,0.10),0_8px_10px_-6px_rgba(0,0,0,0.10)] hover:-translate-y-0.5 hover:shadow-[0_25px_30px_-5px_rgba(0,0,0,0.18),0_10px_12px_-6px_rgba(0,0,0,0.12)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-primary)]"
      >
        <span>Submit</span>
        <svg
          width="18"
          height="18"
          viewBox="0 0 18 18"
          fill="none"
          aria-hidden="true"
          class="transition-transform duration-300 ease-out group-hover:translate-x-1"
        >
          <path
            d="M3 9h12M10 4l5 5-5 5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
    </form>
  </div>
</section>

<style>
  /* Shared input styling — matches Figma's 1px navy-20 border + 4px radius */
  .contact-input {
    width: 100%;
    padding: 12px;
    border-radius: var(--radius-s, 4px);
    border: 1px solid var(--color-primary-20);
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 22px;
    letter-spacing: 0.2px;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }
  .contact-input::placeholder {
    color: var(--color-text);
    opacity: 0.6;
  }
  .contact-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(32, 56, 100, 0.12);
  }
  .contact-input[aria-invalid="true"] {
    border-color: #c0392b;
  }
  .contact-input[aria-invalid="true"]:focus {
    box-shadow: 0 0 0 3px rgba(192, 57, 43, 0.12);
  }

  /*
    Entrance animations — CSS-driven (no GSAP flash on first paint).
    Each piece fades up with a small stagger.
  */
  [data-contact-title],
  [data-contact-divider],
  [data-contact-info] ul li,
  [data-contact-form] > * {
    opacity: 0;
    animation-fill-mode: forwards;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  }
  [data-contact-title] {
    transform: translateY(24px);
    animation-name: contact-fade-up;
    animation-duration: 1s;
  }
  [data-contact-divider] {
    transform: scaleX(0);
    transform-origin: left center;
    animation-name: contact-divider-draw;
    animation-duration: 1.1s;
    animation-delay: 0.4s;
  }
  [data-contact-info] ul li {
    transform: translateY(12px);
    animation-name: contact-fade-up;
    animation-duration: 0.8s;
    animation-delay: calc(0.5s + var(--i, 0) * 0.08s);
  }
  [data-contact-info] ul li:nth-child(1) { --i: 0; }
  [data-contact-info] ul li:nth-child(2) { --i: 1; }
  [data-contact-info] ul li:nth-child(3) { --i: 2; }
  [data-contact-info] ul li:nth-child(4) { --i: 3; }
  [data-contact-info] ul li:nth-child(5) { --i: 4; }
  [data-contact-form] > * {
    transform: translateY(16px);
    animation-name: contact-fade-up;
    animation-duration: 0.8s;
    animation-delay: calc(0.3s + var(--i, 0) * 0.08s);
  }
  [data-contact-form] > *:nth-child(1) { --i: 0; }
  [data-contact-form] > *:nth-child(2) { --i: 1; }
  [data-contact-form] > *:nth-child(3) { --i: 2; }
  [data-contact-form] > *:nth-child(4) { --i: 3; }
  [data-contact-form] > *:nth-child(5) { --i: 4; }
  [data-contact-form] > *:nth-child(6) { --i: 5; }

  @keyframes contact-fade-up {
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes contact-divider-draw {
    to { opacity: 1; transform: scaleX(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-contact-title],
    [data-contact-divider],
    [data-contact-info] ul li,
    [data-contact-form] > * {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>

<script>
  // Entrance animations are CSS-driven now (see <style> block above).

  // ── Form handling ──
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const status = document.querySelector<HTMLParagraphElement>("[data-contact-status]");

  if (form && status) {
    const showStatus = (text: string, kind: "success" | "error") => {
      status.textContent = text;
      status.classList.remove("hidden", "text-green-700", "text-red-700");
      status.classList.add(kind === "success" ? "text-green-700" : "text-red-700");
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Lightweight validation — HTML5 already covers required/type=email
      let firstInvalid: HTMLElement | null = null;
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input, textarea").forEach((el) => {
        const valid = el.checkValidity();
        el.setAttribute("aria-invalid", valid ? "false" : "true");
        if (!valid && !firstInvalid) firstInvalid = el;
      });

      if (firstInvalid) {
        (firstInvalid as HTMLElement).focus();
        showStatus("Please fix the highlighted fields and try again.", "error");
        return;
      }

      // Submit to the WordPress Contact Form 7 endpoint.
      // CF7 emails the submission via Postmark and stores it in Flamingo (WP DB).
      const FEEDBACK_URL =
        "https://bluestone-wp.designinx.com/wp-json/contact-form-7/v1/contact-forms/378/feedback";
      const data = new FormData(form);
      data.append("_wpcf7", "378");
      data.append("_wpcf7_unit_tag", "wpcf7-f378-o1");
      data.append("_wpcf7_locale", "en_US");

      const submitBtn = form.querySelector<HTMLButtonElement>("[type=submit]");
      if (submitBtn) submitBtn.disabled = true;
      showStatus("Sending…", "success");

      try {
        const res = await fetch(FEEDBACK_URL, { method: "POST", body: data });
        const json = await res.json();
        if (json.status === "mail_sent") {
          window.location.href = "/thank-you";
          return;
        }
        showStatus(
          json.message || "Something went wrong. Please try again, or email info@bluestoneinv.com.",
          "error",
        );
      } catch (err) {
        showStatus(
          "Network error — please try again, or email info@bluestoneinv.com directly.",
          "error",
        );
      }
      if (submitBtn) submitBtn.disabled = false;
    });
  }
</script>
