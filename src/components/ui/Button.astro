---
import type { Cta } from "@content";

interface Props extends Cta {
  class?: string;
}
const { label, href, variant = "primary", arrow = true, class: className } = Astro.props;

const variantClass =
  variant === "primary"
    ? "bg-[var(--color-primary)] text-[var(--color-bg)] border border-transparent shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1),0_8px_10px_-6px_rgba(0,0,0,0.1)] hover:shadow-[0_25px_30px_-5px_rgba(0,0,0,0.18),0_10px_12px_-6px_rgba(0,0,0,0.12)]"
    : variant === "secondary"
      ? "bg-[var(--color-secondary)] text-[var(--color-primary)] border border-transparent shadow-[0_20px_25px_-5px_rgba(0,0,0,0.1),0_8px_10px_-6px_rgba(0,0,0,0.1)] hover:shadow-[0_25px_30px_-5px_rgba(0,0,0,0.18),0_10px_12px_-6px_rgba(0,0,0,0.12)]"
      : "bg-transparent text-[var(--color-primary)] border border-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-[var(--color-bg)]";
---

<a
  href={href}
  data-cta
  class:list={[
    "group relative inline-flex items-center gap-2 rounded-[4px] px-10 py-5 body-l font-medium",
    "transition-[transform,box-shadow,background-color,color] duration-300 ease-out",
    "hover:-translate-y-0.5",
    "focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-primary)]",
    variantClass,
    className,
  ]}
>
  <span>{label}</span>
  {
    arrow && (
      <svg
        width="18"
        height="18"
        viewBox="0 0 18 18"
        fill="none"
        aria-hidden="true"
        class="transition-transform duration-300 ease-out group-hover:translate-x-1"
      >
        <path
          d="M3 9h12M10 4l5 5-5 5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
</a>
