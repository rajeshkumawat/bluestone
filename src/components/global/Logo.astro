---
/**
 * Bluestone wordmark — real brand SVG, inlined at build time via ?raw import.
 * fill="currentColor" paths are driven by the CSS `color` property.
 *
 * Usage:
 *   <Logo class="text-white" />                      → white logo
 *   <Logo class="text-[var(--color-primary)]" />     → navy logo
 *
 * The Header JS sets svg.style.color for the scroll-flip transition.
 */
import { readFileSync } from "fs";
import { join } from "path";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

// Read the SVG at build/render time via Node fs — process.cwd() is the
// project root in both dev and build modes, avoiding ?raw dev-server issues.
const rawSvg = readFileSync(join(process.cwd(), "src/assets/logo.svg"), "utf-8");

// Set width="100%" so the SVG fills its parent container (header wrapper /
// footer div control the actual pixel size). Remove height so the viewBox
// aspect ratio drives the height automatically. Without this, browsers
// fall back to the raw viewBox dimensions (709px) as the intrinsic size.
const svg = rawSvg
  .replace(/^<svg /, `<svg class="logo${className ? " " + className : ""}" aria-hidden="true" overflow="visible" `)
  .replace(/\s+width="[^"]*"/, ' width="100%"')
  .replace(/\s+height="[^"]*"/, ' height="auto"');
---

<Fragment set:html={svg} />
