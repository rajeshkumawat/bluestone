---
/**
 * DRAFT — Investment Detail Popup (logo right, description left)
 * Preview at /draft-investment before applying to all investment modals.
 * Uses Valiant Solutions as the sample company.
 * DELETE this file once the layout is approved.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import { getInvestmentBySlug, getArticles } from "@content";

const investment = await getInvestmentBySlug("valiant-solutions");
if (!investment) throw new Error("investment not found: valiant-solutions");

const allArticles = await getArticles();
const relatedNews = (investment.relatedNews ?? [])
  .map((s) => allArticles.find((a) => a.slug === s))
  .filter(Boolean) as typeof allArticles;

const statusLabel = investment.status === "active" ? "Active" : "Realized";
---

<BaseLayout title={`[DRAFT] ${investment.name}`} description={investment.tagline}>
  <!-- Page bg simulates the dimmed backdrop so the card looks like the real popup -->
  <div
    class="min-h-screen flex items-start justify-center py-16 px-4"
    style="background: rgba(32,56,100,0.85); backdrop-filter: blur(6px);"
  >
    <!-- Modal card — same dimensions/style as the live popup -->
    <article
      class="relative bg-white rounded-[10px] shadow-2xl w-full overflow-y-auto"
      style="max-width: min(960px, calc(100vw - 32px)); max-height: calc(100vh - 64px); overscroll-behavior: contain;"
    >
      <!-- Close button (visual only on draft) -->
      <button
        type="button"
        aria-label="Close"
        class="absolute top-5 right-5 inline-flex h-8 w-8 items-center justify-center text-[var(--color-text)] hover:text-[var(--color-primary)] transition-colors z-10"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>

      <div class="p-8 sm:p-10">

        <!-- ── TOP SECTION: info left | logo right ── -->
        <div class="flex flex-col sm:flex-row gap-6 sm:gap-10">

          <!-- Info column (left) -->
          <div class="flex-1 min-w-0">
            <!-- Company name — display font, weight 400 to match site headings -->
            <h2 class="h3-accent text-[var(--color-text)]">
              {investment.name}
            </h2>

            <!-- Blue rule beneath name -->
            <div class="mt-3 w-8 h-[2px] bg-[var(--color-primary)]"></div>

            <!-- Investment Date | Status -->
            <p class="mt-3 body-l text-[var(--color-text)] opacity-60">
              {investment.platformInvestmentDate && (
                <><span>Investment Date: {investment.platformInvestmentDate}</span>&ensp;|&ensp;</>
              )}
              <span>Status: {statusLabel}</span>
            </p>

            <!-- Description -->
            <div class="mt-4 flex flex-col gap-4">
              {(investment.description ?? []).map((p) => (
                <p class="body-l text-[var(--color-text)]">{p}</p>
              ))}
            </div>
          </div>

          <!-- Logo column (right) -->
          <div class="flex items-center justify-center sm:w-[280px] shrink-0 order-first sm:order-last">
            <img
              src={investment.featuredImage ?? investment.logo}
              alt={investment.name}
              class="h-auto w-auto object-contain"
              style="max-height: 120px; max-width: 240px;"
            />
          </div>

        </div>

        <!-- ── FULL-WIDTH BELOW: acquisitions | news | website ── -->

        <!-- Platform Acquisitions -->
        {
          investment.acquisitions && investment.acquisitions.length > 0 && (
            <div class="mt-8">
              <p class="text-[11px] font-semibold tracking-[1.32px] uppercase text-[var(--color-primary)] mb-4">
                Platform Acquisitions
              </p>
              <div class="flex flex-wrap items-center gap-4">
                {investment.acquisitions.map((a) => (
                  <div
                    class="flex items-center justify-center rounded-[10px] bg-white border border-[var(--color-primary-20)] p-4"
                    style="height: 80px; width: 200px;"
                    title={a.name}
                  >
                    <img
                      src={a.logo}
                      alt={a.name}
                      class="object-contain"
                      style="max-height: 44px; max-width: 144px;"
                      loading="lazy"
                    />
                  </div>
                ))}
              </div>
            </div>
          )
        }

        <!-- Related News -->
        {
          (relatedNews.length > 0 || (investment.externalNews && investment.externalNews.length > 0)) && (
            <div class="mt-8">
              <p class="text-[11px] font-semibold tracking-[1.32px] uppercase text-[var(--color-primary)] mb-4">
                Related News
              </p>
              <ul class="flex flex-col gap-2">
                {relatedNews.map((a) => (
                  <li>
                    <a
                      href={`/news/${a.slug}`}
                      class="body-l tracking-[1px] text-[var(--color-text)] hover:text-[var(--color-primary)] transition-colors"
                    >
                      {a.title}
                    </a>
                  </li>
                ))}
                {(investment.externalNews ?? []).map((item) => (
                  <li>
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="body-l text-[var(--color-text)] hover:text-[var(--color-primary)] transition-colors inline-flex items-start gap-2 group"
                    >
                      <span class="mt-[5px] shrink-0 opacity-50 group-hover:opacity-100 transition-opacity">↗</span>
                      <span>{item.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <!-- Website -->
        {
          investment.website && (
            <p class="mt-6 body-l tracking-[1px] text-[var(--color-text)]">
              <strong>Website:</strong>&nbsp;&nbsp;
              <a
                href={investment.website}
                target="_blank"
                rel="noopener noreferrer"
                class="underline hover:text-[var(--color-primary)] transition-colors"
              >
                {investment.website.replace(/^https?:\/\//, "")}
              </a>
            </p>
          )
        }

      </div>
    </article>
  </div>
</BaseLayout>
